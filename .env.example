ADMIN_EMAIL=admin@example.com
# Genera el hash con: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu-password-seguro'))"
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$xxxxxxxxxxxxxxxx$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLASK_SECRET_KEY=generate-a-random-secret-key-here-min-32-chars

# Turso (optional - for multi-user auth). Omit for local-only sqlite fallback.
# TURSO_URL=libsql://my-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
